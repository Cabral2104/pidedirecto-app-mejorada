# ─── .env.local ──────────────────────────────────────────────────────────────
# Copia este archivo y ponle el nombre `.env.local` en la raíz del proyecto.
# Rellena cada valor con las credenciales de tu proyecto Firebase.
# Las encuentras en: Firebase Console → ⚙️ Configuración → Tus apps → Web app → SDK
#
# ⚠️  Agrega .env.local a tu .gitignore — nunca lo subas a GitHub.

VITE_FIREBASE_API_KEY=tu_api_key_aqui
VITE_FIREBASE_AUTH_DOMAIN=pidedirecto-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=pidedirecto-app
VITE_FIREBASE_STORAGE_BUCKET=pidedirecto-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id_aqui
VITE_FIREBASE_APP_ID=tu_app_id_aqui
